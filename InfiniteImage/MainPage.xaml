<Page x:Class="InfiniteImage.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:InfiniteImage"
      xmlns:controls="using:InfiniteImage.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      KeyDown="OnKeyDown"
      KeyUp="OnKeyUp">

    <Page.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#0A0A12" Offset="0" />
            <GradientStop Color="#050507" Offset="1" />
        </LinearGradientBrush>
    </Page.Background>

    <Grid x:Name="RootGrid">
        <!-- 3D Canvas Area -->
        <Canvas x:Name="Canvas3D"
                PointerPressed="OnPointerPressed"
                PointerMoved="OnPointerMoved"
                PointerReleased="OnPointerReleased"
                PointerWheelChanged="OnPointerWheelChanged"
                ManipulationMode="All"
                ManipulationDelta="OnManipulationDelta" />

        <!-- Vignette Overlay -->
        <Border x:Name="VignetteOverlay"
                IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5"
                                     RadiusX="0.8"
                                     RadiusY="0.8">
                    <GradientStop Color="#00000000" Offset="0.3" />
                    <GradientStop Color="#60000000" Offset="0.8" />
                    <GradientStop Color="#B0000000" Offset="1.0" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Center Reticle -->
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              Opacity="0.5">
            <!-- Crosshair lines -->
            <Border Width="20" Height="2" Background="#60FFFFFF" CornerRadius="1" />
            <Border Width="2" Height="20" Background="#60FFFFFF" CornerRadius="1" />
            <!-- Center dot -->
            <Ellipse Width="4" Height="4" Fill="{ThemeResource PrimaryBrush}" />
        </Grid>

        <!-- Top-Left: Title with glow -->
        <Border Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#80000000"
                CornerRadius="12"
                Padding="16,12"
                Translation="0,0,16"
                IsHitTestVisible="False">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#x221E;"
                               FontSize="22"
                               Foreground="{ThemeResource PrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Memory Drift"
                               Style="{StaticResource TitleMedium}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Glide through your memories."
                           Style="{StaticResource BodySmall}"
                           Foreground="#80FFFFFF"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Top-Right: Coordinates Panel -->
        <Border Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#80000000"
                CornerRadius="12"
                Padding="14,10"
                Translation="0,0,16"
                IsHitTestVisible="False">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="X"
                           Style="{StaticResource LabelSmall}"
                           Foreground="#60FFFFFF"
                           FontWeight="Medium" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{x:Bind _viewModel.CoordX, Mode=OneWay}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="White"
                           FontFamily="Consolas"
                           HorizontalAlignment="Right" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Y"
                           Style="{StaticResource LabelSmall}"
                           Foreground="#60FFFFFF"
                           FontWeight="Medium" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{x:Bind _viewModel.CoordY, Mode=OneWay}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="White"
                           FontFamily="Consolas"
                           HorizontalAlignment="Right" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Z"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource TertiaryBrush}"
                           FontWeight="Bold" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{x:Bind _viewModel.CoordZ, Mode=OneWay}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource TertiaryBrush}"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           HorizontalAlignment="Right" />

                <TextBlock Grid.Row="4" Grid.ColumnSpan="2"
                           Text="{x:Bind _viewModel.FpsText, Mode=OneWay}"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource PrimaryBrush}"
                           FontFamily="Consolas"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- Bottom-Left: Navigation Help -->
        <Border Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#80000000"
                CornerRadius="12"
                Padding="14,12"
                Translation="0,0,16"
                IsHitTestVisible="False">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="6">
                <TextBlock Text="CONTROLS"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource PrimaryBrush}"
                           FontWeight="Bold"
                           Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="W A S D"
                               Style="{StaticResource LabelSmall}" Foreground="White" FontFamily="Consolas" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Pan"
                               Style="{StaticResource LabelSmall}" Foreground="#80FFFFFF" Margin="8,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="E / Q"
                               Style="{StaticResource LabelSmall}" Foreground="{ThemeResource TertiaryBrush}" FontFamily="Consolas" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Fly depth"
                               Style="{StaticResource LabelSmall}" Foreground="#80FFFFFF" Margin="8,0,0,0" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Scroll"
                               Style="{StaticResource LabelSmall}" Foreground="White" FontFamily="Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Fly through"
                               Style="{StaticResource LabelSmall}" Foreground="#80FFFFFF" Margin="8,0,0,0" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Drag"
                               Style="{StaticResource LabelSmall}" Foreground="White" FontFamily="Consolas" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Look around"
                               Style="{StaticResource LabelSmall}" Foreground="#80FFFFFF" Margin="8,0,0,0" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="R"
                               Style="{StaticResource LabelSmall}" Foreground="{ThemeResource PrimaryBrush}" FontFamily="Consolas" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Reset"
                               Style="{StaticResource LabelSmall}" Foreground="#80FFFFFF" Margin="8,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom-Right: Stats -->
        <Border Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#80000000"
                CornerRadius="12"
                Padding="14,12"
                Translation="0,0,16"
                IsHitTestVisible="False">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Spacing="6">
                <TextBlock Text="STATS"
                           Style="{StaticResource LabelSmall}"
                           Foreground="{ThemeResource PrimaryBrush}"
                           FontWeight="Bold"
                           Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Chunks"
                               Style="{StaticResource LabelSmall}" Foreground="#60FFFFFF" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{x:Bind _viewModel.ChunkCountText, Mode=OneWay}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="White"
                               FontFamily="Consolas"
                               HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Planes"
                               Style="{StaticResource LabelSmall}" Foreground="#60FFFFFF" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{x:Bind _viewModel.PlaneCountText, Mode=OneWay}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="White"
                               FontFamily="Consolas"
                               HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Depth"
                               Style="{StaticResource LabelSmall}" Foreground="{ThemeResource TertiaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{x:Bind _viewModel.DepthText, Mode=OneWay}"
                               Style="{StaticResource LabelSmall}"
                               Foreground="{ThemeResource TertiaryBrush}"
                               FontFamily="Consolas"
                               FontWeight="Bold"
                               HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom-Center: Speed Bar -->
        <StackPanel Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Spacing="8">
            <Grid Width="240" Height="6">
                <!-- Background track -->
                <Border CornerRadius="3"
                        Background="#20FFFFFF" />
                <!-- Active bar with glow -->
                <Border CornerRadius="3"
                        HorizontalAlignment="Left"
                        Width="{x:Bind _viewModel.SpeedBarWidth, Mode=OneWay}"
                        Translation="0,0,8">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7C5CFF" Offset="0" />
                            <GradientStop Color="#4ADE80" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="&#x2191;"
                           FontSize="10"
                           Foreground="#60FFFFFF" />
                <TextBlock Text="VELOCITY"
                           Style="{StaticResource LabelSmall}"
                           Foreground="#60FFFFFF"
                           FontWeight="Medium" />
            </StackPanel>
        </StackPanel>

        <!-- Motion Blur Glow (scales with Z velocity) -->
        <Border IsHitTestVisible="False"
                Opacity="{x:Bind _viewModel.MotionGlowOpacity, Mode=OneWay}">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#307C5CFF" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</Page>
